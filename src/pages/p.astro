---
import Layout from '../layouts/Layout.astro';
import Wheel from '../components/Wheel.astro';
---

<Layout title="Minhas caronas">
  <header class="topbar">
    <span class="topbar__brand"><Wheel /> Caronas</span>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Alternar tema claro e escuro">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
  </header>

  <p id="erro" class="erro" role="alert" hidden></p>
  <div id="anuncio" class="sr-only" aria-live="polite"></div>

  <main class="wrap">
    <p id="carregando" class="estado">Carregando…</p>

    <section id="invalido" class="estado" hidden>
      <h1>Link inválido</h1>
      <p>Peça ao motorista para enviar seu link novamente. Cada passageiro possui um link exclusivo.</p>
    </section>

    <div id="app" hidden>
      <section class="cabecalho">
        <h1 id="ola" class="ola"></h1>
        <p id="escala" class="escala muted"></p>
      </section>

      <section class="secao-acoes">
        <span class="label">ações rápidas</span>
        <div id="acoes" class="acoes"></div>
      </section>

      <nav class="mesnav">
        <button id="mes-ant" class="icon-btn" type="button" aria-label="Mês anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <h2 id="mes-nome" class="mesnav__nome"></h2>
        <button id="mes-prox" class="icon-btn" type="button" aria-label="Próximo mês">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </nav>

      <section class="resumo card">
        <div class="resumo__topo">
          <span class="label">acumulado até hoje</span>
          <span id="resumo-status" class="badge"></span>
        </div>
        <p id="resumo-valor" class="resumo__valor num">R$ 0,00</p>
        <p id="resumo-linha" class="muted resumo__linha"></p>
      </section>

      <section class="secao-dias">
        <span class="label">seus dias no mês</span>
        <ul id="dias" class="dias"></ul>
      </section>

      <section class="ajuda card">
        <span class="label">como funciona</span>
        <ul class="ajuda__lista">
          <li><strong>Caronas automáticas:</strong> As caronas entram sozinhas nos seus dias agendados (<span id="ajuda-escala"></span>).</li>
          <li><strong>Marque apenas faltas:</strong> Você não precisa confirmar presença. Só toque no botão quando não for andar.</li>
          <li><strong>Transparência:</strong> O motorista enxerga suas marcações na hora e o valor é atualizado em tempo real.</li>
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .erro {
    position: sticky;
    top: 0;
    z-index: 30;
    margin: 0;
    padding: 0.7rem 1rem;
    background: var(--accent-strong);
    color: #fff;
    font-size: 0.85rem;
  }

  .estado {
    margin-top: 3rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .estado h1 {
    font-size: 1.3rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .cabecalho {
    margin-top: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .ola {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .escala {
    font-size: 0.92rem;
    margin-top: 0.25rem;
    line-height: 1.45;
  }

  .secao-acoes {
    margin-bottom: 1.75rem;
  }

  .acoes {
    display: grid;
    gap: 0.6rem;
  }

  .acoes .btn[aria-pressed='true'] {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }

  .acoes__nota {
    font-size: 0.82rem;
    color: var(--text-secondary);
    text-align: center;
    margin-top: 0.25rem;
  }

  .mesnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .mesnav__nome {
    font-size: 1rem;
    font-weight: 600;
    text-transform: lowercase;
  }

  .resumo {
    margin: 0.85rem 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .resumo__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .resumo__topo .label {
    margin-bottom: 0;
  }

  .resumo__valor {
    font-size: 2.75rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .resumo__linha {
    font-size: 0.85rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .badge--success {
    background: color-mix(in srgb, var(--success) 12%, transparent);
    color: var(--success);
    border: 1px solid color-mix(in srgb, var(--success) 30%, transparent);
  }

  .badge--pending {
    background: var(--bg-card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  .secao-dias {
    margin-bottom: 2rem;
  }

  .dias {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .dias li {
    border-bottom: 1px solid var(--border);
  }

  .dias li:last-child {
    border-bottom: none;
  }

  .dia {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: var(--tap);
    padding: 0.6rem 0.85rem;
    text-align: left;
    background: var(--bg-primary);
    transition: background var(--transition-fast);
  }

  .dia:hover {
    background: var(--bg-card-hover);
  }

  .dia__info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .dia__data {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .dia__estado {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.88rem;
    font-weight: 500;
  }

  li.hoje-linha .dia {
    box-shadow: inset 3px 0 0 var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  li.hoje-linha .dia__data {
    color: var(--accent);
    font-weight: 700;
  }

  .dia[data-estado='absent'] .dia__estado {
    color: var(--accent);
    font-weight: 600;
  }

  .dia[data-estado='noride'] .dia__estado {
    color: var(--text-secondary);
  }

  .dia[data-estado='ride'] .dia__estado {
    color: var(--text-primary);
  }

  .mark {
    display: inline-block;
    width: 10px;
    height: 10px;
    flex: none;
    border-radius: 50%;
    background: var(--p0);
  }

  .mark--absent {
    width: auto;
    height: auto;
    background: none;
    color: var(--accent);
    font-weight: 700;
    line-height: 1;
    font-size: 0.95rem;
  }

  .mark--off {
    width: 10px;
    height: 2px;
    border-radius: 0;
    background: var(--text-secondary);
  }

  .ajuda {
    margin-top: 2rem;
  }

  .ajuda__lista {
    display: grid;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .ajuda__lista strong {
    color: var(--text-primary);
  }
</style>

<script>
  import {
    addDays,
    brl,
    isRideDay,
    monthDays,
    monthKey,
    monthLabel,
    parseYmd,
    report,
    weekdayList,
    WEEKDAY_SHORT,
    ymd,
  } from '../lib/rides';
  import { feriados } from '../lib/feriados';
  import { configured, loadMonth, loadPassengerByToken, setMark } from '../lib/db';
  import type { Passenger } from '../lib/rides';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const hoje = ymd(new Date());
  const token = new URLSearchParams(location.search).get('t') ?? '';
  let cursor = new Date();
  let eu: Passenger;
  let mes: Awaited<ReturnType<typeof loadMonth>>;

  function erro(msg: string) {
    const el = $('erro');
    el.textContent = msg;
    el.hidden = false;
    setTimeout(() => (el.hidden = true), 6000);
  }

  function anunciar(msg: string) {
    const el = $('anuncio');
    if (el) el.textContent = msg;
  }

  async function commit(fn: () => Promise<void>) {
    try {
      await fn();
      await carregar();
    } catch (e: any) {
      erro(e?.message ?? 'Não deu para salvar. Tente de novo.');
    }
  }

  const escalado = (dia: string) =>
    eu.weekdays.includes(parseYmd(dia).getDay()) &&
    dia >= eu.start_date &&
    (!eu.end_date || dia <= eu.end_date);

  const marcas = () => mes.marks.get(eu.id) ?? new Map<string, boolean>();
  const faltou = (dia: string) => marcas().get(dia) === false;

  function rotulo(dia: string) {
    const d = parseYmd(dia);
    return `${WEEKDAY_SHORT[d.getDay()]} ${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  async function carregar() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    // The month on screen may not contain today, and the buttons up top speak
    // about today and tomorrow. So the fetched window covers both.
    const de = dias[0] < hoje ? dias[0] : hoje;
    const ate = dias[dias.length - 1] > addDays(hoje, 1) ? dias[dias.length - 1] : addDays(hoje, 1);
    try {
      mes = await loadMonth(de, ate, monthKey(ano, m0));
      render();
    } catch (e: any) {
      erro(e?.message ?? 'Não deu para carregar o mês.');
    }
  }

  function render() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    const fer = feriados(ano);

    $('ola').textContent = `Oi, ${eu.name.split(' ')[0]}`;
    const diasSemana = weekdayList(eu.weekdays);
    $('escala').textContent = `Sua escala é ${diasSemana}. As caronas entram sozinhas nesses dias e você só marca quando não for.`;
    $('ajuda-escala').textContent = diasSemana;
    $('mes-nome').textContent = monthLabel(ano, m0);

    renderAcoes();

    const r = report(eu, dias, marcas(), mes.overrides, fer, hoje);
    $('resumo-valor').textContent = brl(r.total);

    const pago = mes.paid.has(eu.id);
    const statusEl = $('resumo-status');
    if (pago) {
      statusEl.className = 'badge badge--success';
      statusEl.textContent = '✓ Pago ao motorista';
    } else {
      statusEl.className = 'badge badge--pending';
      statusEl.textContent = 'A pagar no final do mês';
    }

    const partes = [`${r.done} ${r.done === 1 ? 'carona realizada' : 'caronas realizadas'} × ${brl(eu.fare)}`];
    if (r.faltas) partes.push(`${r.faltas} ${r.faltas === 1 ? 'falta' : 'faltas'}`);
    $('resumo-linha').textContent = partes.join(' · ');

    renderDias(dias, fer);
  }

  function renderAcoes() {
    const el = $('acoes');
    el.innerHTML = '';

    const a0 = Number(hoje.slice(0, 4));
    const a1 = Number(addDays(hoje, 14).slice(0, 4));
    const fer = new Map([...feriados(a0), ...feriados(a1)]);

    const candidatos: string[] = [];
    for (const dia of [hoje, addDays(hoje, 1)]) {
      if (escalado(dia) && isRideDay(dia, mes.overrides, fer)) candidatos.push(dia);
    }

    if (candidatos.length === 0) {
      let d = hoje;
      for (let i = 0; i < 14 && candidatos.length === 0; i++) {
        d = addDays(d, 1);
        if (escalado(d) && isRideDay(d, mes.overrides, fer)) candidatos.push(d);
      }
    }

    if (candidatos.length === 0) {
      const p = document.createElement('p');
      p.className = 'acoes__nota';
      p.textContent = 'Nenhuma carona sua nos próximos dias.';
      el.append(p);
      return;
    }

    candidatos.forEach((dia, i) => {
      const marcada = faltou(dia);
      const quando = dia === hoje ? 'hoje' : dia === addDays(hoje, 1) ? 'amanhã' : rotulo(dia);
      const b = document.createElement('button');
      b.type = 'button';
      b.className = `btn btn--block ${i === 0 && !marcada ? 'btn--primary btn--lg' : 'btn--ghost'}`;
      b.setAttribute('aria-pressed', String(marcada));
      b.setAttribute(
        'aria-label',
        marcada ? `Desfazer falta de ${quando}` : `Marcar falta de ${quando}`,
      );
      b.textContent = marcada ? `Voltei atrás, vou ${quando}` : `Não vou ${quando}`;
      b.onclick = () =>
        commit(async () => {
          await setMark(eu.id, dia, marcada ? null : false);
          anunciar(marcada ? `Falta de ${quando} desfeita.` : `Falta de ${quando} registrada.`);
        });
      el.append(b);
    });

    const nota = document.createElement('p');
    nota.className = 'acoes__nota';
    const marcadas = candidatos.filter(faltou).map((d) => (d === hoje ? 'hoje' : 'amanhã'));
    nota.textContent = marcadas.length
      ? `Falta de ${marcadas.join(' e ')} registrada. O motorista já vê.`
      : 'Nas caronas agendadas, a presença entra sozinha.';
    el.append(nota);
  }

  function renderDias(dias: string[], fer: Map<string, string>) {
    const el = $('dias');
    el.innerHTML = '';

    for (const dia of dias) {
      if (!escalado(dia)) continue;
      const rodou = isRideDay(dia, mes.overrides, fer);
      const falta = faltou(dia);
      const estado = !rodou ? 'noride' : falta ? 'absent' : 'ride';

      const li = document.createElement('li');
      if (dia === hoje) li.className = 'hoje-linha';

      const texto = !rodou
        ? (fer.get(dia) ?? 'sem carona')
        : falta
          ? 'faltou (descontado)'
          : dia > hoje
            ? 'agendado'
            : 'foi';
      const marca = !rodou
        ? '<span class="mark mark--off" aria-hidden="true"></span>'
        : falta
          ? '<span class="mark mark--absent" aria-hidden="true">✕</span>'
          : '<span class="mark" aria-hidden="true"></span>';

      if (!rodou) {
        const div = document.createElement('div');
        div.className = 'dia';
        div.dataset.estado = estado;
        div.innerHTML = `
          <div class="dia__info">
            <span class="dia__data">${rotulo(dia)}</span>
            <span class="dia__estado">${marca} ${texto}</span>
          </div>`;
        li.append(div);
      } else {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'dia';
        b.dataset.estado = estado;
        b.setAttribute('aria-pressed', String(falta));
        b.setAttribute(
          'aria-label',
          `${rotulo(dia)}: ${falta ? 'falta registrada. Toque para desfazer.' : 'carona confirmada. Toque para marcar falta.'}`,
        );
        b.innerHTML = `
          <div class="dia__info">
            <span class="dia__data">${rotulo(dia)}</span>
            <span class="dia__estado">${marca} ${texto}</span>
          </div>`;
        b.onclick = () =>
          commit(async () => {
            await setMark(eu.id, dia, falta ? null : false);
            anunciar(falta ? `Falta de ${rotulo(dia)} desfeita.` : `Falta de ${rotulo(dia)} registrada.`);
          });
        li.append(b);
      }
      el.append(li);
    }
  }

  $('mes-ant').onclick = () => {
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
    carregar();
  };
  $('mes-prox').onclick = () => {
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
    carregar();
  };

  async function iniciar() {
    if (!configured || !token) {
      $('carregando').hidden = true;
      $('invalido').hidden = false;
      return;
    }
    try {
      const p = await loadPassengerByToken(token);
      if (!p) {
        $('carregando').hidden = true;
        $('invalido').hidden = false;
        return;
      }
      eu = p;
      $('carregando').hidden = true;
      $('app').hidden = false;
      await carregar();
    } catch (e: any) {
      $('carregando').hidden = true;
      $('invalido').hidden = false;
    }
  }

  iniciar();
</script>
