---
import Layout from '../layouts/Layout.astro';
import Wheel from '../components/Wheel.astro';
---

<Layout title="Minhas caronas">
  <header class="topbar">
    <span class="topbar__brand"><Wheel /> Caronas</span>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Alternar tema claro e escuro">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
  </header>

  <p id="erro" class="toast" role="alert" hidden></p>
  <div id="anuncio" class="sr-only" aria-live="polite"></div>

  <main class="wrap">
    <p id="carregando" class="estado">Carregando…</p>

    <section id="invalido" class="estado" hidden>
      <h1>Link inválido</h1>
      <p>Peça ao motorista para enviar seu link novamente. Cada passageiro possui um link exclusivo.</p>
    </section>

    <div id="app" hidden>
      <section class="cabecalho">
        <h1 id="ola" class="ola"></h1>
        <p id="escala" class="escala muted"></p>
      </section>

      <!-- Hero Card: Próxima Carona com Ação Imediata -->
      <section id="hero-carona" class="hero-card card"></section>

      <!-- Resumo de Caronas e Navegador de Mês -->
      <nav class="mesnav">
        <button id="mes-ant" class="icon-btn" type="button" aria-label="Mês anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <h2 id="mes-nome" class="mesnav__nome"></h2>
        <button id="mes-prox" class="icon-btn" type="button" aria-label="Próximo mês">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </nav>

      <section class="resumo card">
        <div class="resumo__topo">
          <span class="label">a pagar até hoje</span>
          <span id="resumo-status" class="badge"></span>
        </div>
        <p id="resumo-valor" class="resumo__valor num">R$ 0,00</p>
        <p id="resumo-linha" class="muted resumo__linha"></p>
      </section>

      <!-- Calendário Mensal (Dom a Sáb com dias futuros em amarelo) -->
      <section class="secao-calendario">
        <span class="label">calendário do mês</span>
        <div class="calendario card">
          <div class="cal-dias-semana" aria-hidden="true">
            <span>Dom</span><span>Seg</span><span>Ter</span><span>Qua</span><span>Qui</span><span>Sex</span><span>Sáb</span>
          </div>
          <div id="cal-grade" class="cal-grade" role="grid" aria-label="Dias do mês"></div>
          
          <div id="cal-detalhe" class="cal-detalhe" hidden></div>

          <div class="cal-legenda">
            <span class="cal-legenda__item"><span class="cal-dot cal-dot--ride">✓</span> Realizada</span>
            <span class="cal-legenda__item"><span class="cal-dot cal-dot--agendado">●</span> Agendada</span>
            <span class="cal-legenda__item"><span class="cal-dot cal-dot--absent">✕</span> Falta</span>
            <span class="cal-legenda__item"><span class="cal-dot cal-dot--noride">—</span> Sem carona</span>
          </div>
        </div>
      </section>

      <section class="ajuda card">
        <span class="label">como funciona</span>
        <ul class="ajuda__lista">
          <li><strong>Vaga confirmada:</strong> Sua presença já entra automaticamente em todos os seus dias agendados (<span id="ajuda-escala"></span>).</li>
          <li><strong>Avise apenas faltas:</strong> Toque no botão acima ou no calendário para avisar quando não for.</li>
          <li><strong>Prazo:</strong> Faltas devem ser informadas até o próprio dia da viagem.</li>
          <li><strong>Transparência:</strong> O motorista vê suas marcações na hora e a lista do mês fica sempre atualizada.</li>
        </ul>
      </section>
    </div>
  </main>
</Layout>

<style is:global>
  .estado {
    margin-top: 3rem;
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  .estado h1 {
    font-size: 1.3rem;
    color: var(--text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .cabecalho {
    margin-top: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .ola {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .escala {
    font-size: 0.92rem;
    margin-top: 0.25rem;
    line-height: 1.45;
  }

  /* --- Hero Card --- */
  .hero-card {
    padding: 1.25rem;
    margin-bottom: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    border-radius: var(--radius-md);
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .hero-card--active {
    border-color: color-mix(in srgb, var(--success) 35%, var(--border));
    background: color-mix(in srgb, var(--success) 4%, var(--bg-card));
  }

  .hero-card--absent {
    border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
    background: color-mix(in srgb, var(--accent) 5%, var(--bg-card));
  }

  .hero-card__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hero-card__topo .label {
    margin-bottom: 0;
  }

  .hero-card__corpo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .hero-card__titulo {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .hero-card__sub {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .dot-pulse {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--success);
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.4);
    }
    70% {
      box-shadow: 0 0 0 6px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .btn--danger-soft {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border-color: color-mix(in srgb, var(--accent) 30%, transparent);
    color: var(--accent);
  }

  .btn--danger-soft:hover {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    border-color: var(--accent);
  }

  .btn--success-soft {
    background: color-mix(in srgb, var(--success) 10%, transparent);
    border-color: color-mix(in srgb, var(--success) 30%, transparent);
    color: var(--success);
  }

  .btn--success-soft:hover {
    background: color-mix(in srgb, var(--success) 18%, transparent);
    border-color: var(--success);
  }

  /* --- Resumo & Navegação --- */
  .mesnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .mesnav__nome {
    font-size: 1rem;
    font-weight: 600;
    text-transform: lowercase;
    view-transition-name: mes;
  }

  .resumo {
    margin: 0.85rem 0 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .resumo__topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .resumo__topo .label {
    margin-bottom: 0;
  }

  .resumo__valor {
    font-size: 2.25rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .resumo__linha {
    font-size: 0.85rem;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .badge--success {
    background: color-mix(in srgb, var(--success) 12%, transparent);
    color: var(--success);
    border: 1px solid color-mix(in srgb, var(--success) 30%, transparent);
  }

  .badge--danger {
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .badge--pending {
    background: var(--bg-card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
  }

  /* --- Calendário Mensal --- */
  .secao-calendario {
    margin-bottom: 1.75rem;
  }

  .calendario {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .cal-dias-semana {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--border);
  }

  .cal-grade {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }

  .cal-celula {
    position: relative;
    min-height: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--text-faint);
    background: none;
    transition: background var(--transition-fast), border-color var(--transition-fast),
      scale var(--transition-fast);
  }

  .cal-celula--vazia {
    pointer-events: none;
  }

  .cal-celula__num {
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .cal-celula__status {
    font-size: 0.65rem;
    margin-top: 3px;
    line-height: 1;
    font-weight: 700;
  }

  .cal-celula--fora {
    color: var(--text-faint);
    opacity: 0.4;
  }

  /* Dias já realizados (passados): Verde */
  .cal-celula--ride {
    color: var(--text-primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--success) 12%, transparent);
    border-color: color-mix(in srgb, var(--success) 28%, transparent);
  }

  .cal-celula--ride .cal-celula__status {
    color: var(--success);
  }

  /* Dias agendados (futuros/hoje): Amarelo / Dourado */
  .cal-celula--agendado {
    color: var(--text-primary);
    font-weight: 600;
    background: color-mix(in srgb, var(--p2) 15%, transparent);
    border-color: color-mix(in srgb, var(--p2) 38%, transparent);
  }

  .cal-celula--agendado .cal-celula__status {
    color: var(--p2);
  }

  /* Faltas: Vermelho */
  .cal-celula--absent {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .cal-celula--absent .cal-celula__status {
    color: var(--accent);
  }

  .cal-celula--noride {
    background: var(--bg-card-hover);
    color: var(--text-secondary);
    text-decoration: line-through;
  }

  .cal-celula--hoje {
    outline: 2px solid var(--accent);
    outline-offset: -1px;
  }

  .cal-celula:not(.cal-celula--vazia):hover {
    filter: brightness(0.95);
  }

  .cal-celula:active {
    scale: 0.92;
  }

  .cal-detalhe {
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    border: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-primary);
    text-align: center;
    font-variant-numeric: tabular-nums;
    animation: toast-entra 180ms ease both;
  }

  .cal-legenda {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.85rem;
    padding-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
    border-top: 1px solid var(--border);
  }

  .cal-legenda__item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .cal-dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .cal-dot--ride {
    background: color-mix(in srgb, var(--success) 20%, transparent);
    color: var(--success);
  }

  .cal-dot--agendado {
    background: color-mix(in srgb, var(--p2) 25%, transparent);
    color: var(--p2);
  }

  .cal-dot--absent {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
    color: var(--accent);
  }

  .cal-dot--noride {
    background: var(--bg-card-hover);
    color: var(--text-secondary);
  }

  .ajuda {
    margin-top: 2rem;
  }

  .ajuda__lista {
    display: grid;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .ajuda__lista strong {
    color: var(--text-primary);
  }
</style>

<script>
  import {
    addDays,
    brl,
    isRideDay,
    monthDays,
    monthKey,
    monthLabel,
    parseYmd,
    report,
    weekdayList,
    WEEKDAY_SHORT,
    ymd,
  } from '../lib/rides';
  import { feriados } from '../lib/feriados';
  import { configured, loadMonth, loadPassengerByToken, setMark } from '../lib/db';
  import type { Passenger } from '../lib/rides';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const hoje = ymd(new Date());
  const token = new URLSearchParams(location.search).get('t') ?? '';
  let cursor = new Date();
  let eu: Passenger;
  let mes: Awaited<ReturnType<typeof loadMonth>>;

  // One toast, two meanings, so `ok` is set on every call. Leaving it sticky
  // painted every error after the first success in the success colour.
  function toast(msg: string, ok: boolean) {
    const el = $('erro');
    el.textContent = msg;
    el.dataset.ok = ok ? '1' : '0';
    el.hidden = false;
    setTimeout(() => (el.hidden = true), ok ? 3000 : 6000);
  }

  const erro = (msg: string) => toast(msg, false);
  const aviso = (msg: string) => toast(msg, true);

  function anunciar(msg: string) {
    const el = $('anuncio');
    if (el) el.textContent = msg;
  }

  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)');

  function vibrar(ms = 15) {
    try {
      if ('vibrate' in navigator) navigator.vibrate(ms);
    } catch {}
  }

  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  /** `alvo` steps back while the write is in flight. */
  async function commit(fn: () => Promise<void>, alvo?: HTMLElement) {
    alvo?.classList.add('pendente');
    try {
      await fn();
      await carregar();
    } catch (e: any) {
      erro(e?.message ?? 'Não deu para salvar. Tente de novo.');
      alvo?.classList.remove('pendente');
    }
  }

  const escalado = (dia: string) =>
    eu.weekdays.includes(parseYmd(dia).getDay()) &&
    dia >= eu.start_date &&
    (!eu.end_date || dia <= eu.end_date);

  const marcas = () => mes.marks.get(eu.id) ?? new Map<string, boolean>();
  const faltou = (dia: string) => marcas().get(dia) === false;

  function rotulo(dia: string) {
    const d = parseYmd(dia);
    return `${WEEKDAY_SHORT[d.getDay()]} ${String(d.getDate()).padStart(2, '0')}/${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  function rotuloExtenso(dia: string) {
    const d = parseYmd(dia);
    const nomes = ['Domingo', 'Segunda-feira', 'Terça-feira', 'Quarta-feira', 'Quinta-feira', 'Sexta-feira', 'Sábado'];
    return `${nomes[d.getDay()]}, ${d.getDate()}/${String(d.getMonth() + 1).padStart(2, '0')}`;
  }

  async function carregar() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    const de = dias[0] < hoje ? dias[0] : hoje;
    const ate = dias[dias.length - 1] > addDays(hoje, 14) ? dias[dias.length - 1] : addDays(hoje, 14);
    try {
      mes = await loadMonth(de, ate, monthKey(ano, m0));
      pintar();
    } catch (e: any) {
      erro(e?.message ?? 'Não deu para carregar o mês.');
    }
  }

  let direcaoMes: 'ant' | 'prox' | null = null;

  function pintar() {
    const dir = direcaoMes;
    direcaoMes = null;
    if (!dir || semMovimento.matches || !document.startViewTransition) return render();
    document.documentElement.dataset.mes = dir;
    document.startViewTransition(() => render());
  }

  let valorAnterior = '';

  function render() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    const fer = feriados(ano);

    $('ola').textContent = `Oi, ${eu.name.split(' ')[0]}`;
    const diasSemana = weekdayList(eu.weekdays);
    $('escala').textContent = `Sua escala: ${diasSemana}.`;
    $('ajuda-escala').textContent = diasSemana;
    $('mes-nome').textContent = monthLabel(ano, m0);

    renderHero();

    // The number this person opened the link for: what they owe right now.
    // `r.total` counts rides up to today only. plannedTotal is deliberately
    // never shown here — telling somebody on the 3rd that they owe the whole
    // month is telling them about money they do not owe yet.
    const r = report(eu, dias, marcas(), mes.overrides, fer, hoje);
    const valor = brl(r.total);
    const elValor = $('resumo-valor');
    if (valorAnterior && valorAnterior !== valor && !semMovimento.matches) {
      elValor.animate(
        [{ opacity: 0.3, translate: '0 -6px' }, { opacity: 1, translate: '0 0' }],
        { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
      );
    }
    valorAnterior = valor;
    elValor.textContent = valor;

    const pago = mes.paid.has(eu.id);
    const statusEl = $('resumo-status');
    if (pago) {
      statusEl.className = 'badge badge--success';
      statusEl.textContent = '✓ Mês quitado';
    } else {
      statusEl.className = 'badge badge--pending';
      statusEl.textContent = 'Mês em andamento';
    }

    // The count and the fare that produced the figure above, so it can be
    // checked. Still nothing about what the rest of the month will cost.
    const partes = [`${r.done} ${r.done === 1 ? 'carona' : 'caronas'} × ${brl(eu.fare)}`];
    if (r.faltas) partes.push(`${r.faltas} ${r.faltas === 1 ? 'falta avisada' : 'faltas avisadas'}`);
    $('resumo-linha').textContent = partes.join(' · ');

    renderCalendario(dias, fer);
  }

  function renderHero() {
    const el = $('hero-carona');
    el.innerHTML = '';

    const a0 = Number(hoje.slice(0, 4));
    const a1 = Number(addDays(hoje, 14).slice(0, 4));
    const fer = new Map([...feriados(a0), ...feriados(a1)]);

    let proximoDia: string | null = null;
    for (let i = 0; i < 14; i++) {
      const d = addDays(hoje, i);
      if (!escalado(d)) continue;
      // A holiday, or a day the driver called off, is not a next ride, so the
      // scan keeps going instead of stopping on it. Today is the exception:
      // "no ride today" is exactly what somebody opened the app to find out.
      if (i > 0 && !isRideDay(d, mes.overrides, fer)) continue;
      proximoDia = d;
      break;
    }

    if (!proximoDia) {
      el.className = 'hero-card card';
      el.innerHTML = `
        <div class="hero-card__topo">
          <span class="label">próxima carona</span>
          <span class="badge badge--pending">Sem carona</span>
        </div>
        <div class="hero-card__corpo">
          <p class="hero-card__titulo">Nenhuma carona nos próximos dias</p>
          <p class="hero-card__sub">Você não possui dias agendados nas próximas duas semanas.</p>
        </div>`;
      return;
    }

    const dia = proximoDia;
    const rodou = isRideDay(dia, mes.overrides, fer);
    const falta = faltou(dia);
    const quando = dia === hoje ? 'Hoje' : dia === addDays(hoje, 1) ? 'Amanhã' : rotuloExtenso(dia);

    if (!rodou) {
      el.className = 'hero-card card';
      const motivo = fer.get(dia) ?? mes.overrideNotes.get(dia) ?? 'Sem carona';
      el.innerHTML = `
        <div class="hero-card__topo">
          <span class="label">${quando} · ${rotulo(dia)}</span>
          <span class="badge badge--pending">Sem carona</span>
        </div>
        <div class="hero-card__corpo">
          <p class="hero-card__titulo">${esc(motivo)}</p>
          <p class="hero-card__sub">O motorista ou feriado marcaram que não haverá carona neste dia.</p>
        </div>`;
      return;
    }

    if (falta) {
      el.className = 'hero-card card hero-card--absent';
      el.innerHTML = `
        <div class="hero-card__topo">
          <span class="label">${quando} · ${rotulo(dia)}</span>
          <span class="badge badge--danger"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Falta informada</span>
        </div>
        <div class="hero-card__corpo">
          <p class="hero-card__titulo">Você avisou que não vai</p>
          <p class="hero-card__sub">O motorista já foi avisado e sua presença foi desmarcada para este dia.</p>
        </div>`;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn--success-soft btn--block btn--lg';
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> Vou na carona afinal`;
      btn.onclick = () => {
        vibrar(15);
        commit(async () => {
          await setMark(eu.id, dia, null);
          aviso(`Presença confirmada para ${quando.toLowerCase()}.`);
          anunciar(`Falta de ${quando} desfeita.`);
        }, btn);
      };
      el.append(btn);
    } else {
      el.className = 'hero-card card hero-card--active';
      el.innerHTML = `
        <div class="hero-card__topo">
          <span class="label">${quando} · ${rotulo(dia)}</span>
          <span class="badge badge--success"><span class="dot-pulse"></span> Carona confirmada</span>
        </div>
        <div class="hero-card__corpo">
          <p class="hero-card__titulo">Sua presença está garantida</p>
          <p class="hero-card__sub">O motorista já conta com você na carona. Só avise se não for.</p>
        </div>`;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'btn btn--danger-soft btn--block btn--lg';
      btn.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg> Avisar que não vou ${quando === 'Hoje' ? 'hoje' : quando === 'Amanhã' ? 'amanhã' : 'neste dia'}`;
      btn.onclick = () => {
        vibrar(15);
        commit(async () => {
          await setMark(eu.id, dia, false);
          aviso(`Falta informada para ${quando.toLowerCase()}.`);
          anunciar(`Falta de ${quando} registrada.`);
        }, btn);
      };
      el.append(btn);
    }
  }

  function renderCalendario(dias: string[], fer: Map<string, string>) {
    const grade = $('cal-grade');
    const detalheEl = $('cal-detalhe');
    grade.innerHTML = '';
    detalheEl.hidden = true;

    if (dias.length === 0) return;

    // Domingo na esquerda (índice 0) e Sábado na direita (índice 6)
    const primeiroDia = parseYmd(dias[0]);
    const padStart = primeiroDia.getDay(); // 0=Dom, 1=Seg, ..., 6=Sáb

    for (let i = 0; i < padStart; i++) {
      const v = document.createElement('div');
      v.className = 'cal-celula cal-celula--vazia';
      v.setAttribute('aria-hidden', 'true');
      grade.append(v);
    }

    for (const dia of dias) {
      const d = parseYmd(dia);
      const numDia = d.getDate();
      const escDia = escalado(dia);
      const rodou = isRideDay(dia, mes.overrides, fer);
      const falta = faltou(dia);
      const ehHoje = dia === hoje;
      const ehFuturo = dia > hoje;
      const ehFuturoOuHoje = dia >= hoje;

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cal-celula';
      if (ehHoje) btn.classList.add('cal-celula--hoje');

      const diaNumSpan = document.createElement('span');
      diaNumSpan.className = 'cal-celula__num';
      diaNumSpan.textContent = String(numDia);
      btn.append(diaNumSpan);

      let estadoTexto = '';
      if (!escDia) {
        btn.classList.add('cal-celula--fora');
        estadoTexto = `${rotulo(dia)}: fora da sua escala.`;
      } else if (!rodou) {
        btn.classList.add('cal-celula--noride');
        const motivo = fer.get(dia) ?? mes.overrideNotes.get(dia) ?? 'Sem carona';
        estadoTexto = `${rotulo(dia)}: ${motivo}.`;
        const icon = document.createElement('span');
        icon.className = 'cal-celula__status';
        icon.textContent = '—';
        btn.append(icon);
      } else if (falta) {
        btn.classList.add('cal-celula--absent');
        estadoTexto = `${rotulo(dia)}: falta registrada.`;
        const icon = document.createElement('span');
        icon.className = 'cal-celula__status';
        icon.textContent = '✕';
        btn.append(icon);
      } else if (ehFuturo || ehHoje) {
        // Dias agendados que ainda não foram: Amarelo / Dourado
        btn.classList.add('cal-celula--agendado');
        estadoTexto = `${rotulo(dia)}: carona agendada.`;
        const icon = document.createElement('span');
        icon.className = 'cal-celula__status';
        icon.textContent = '●';
        btn.append(icon);
      } else {
        // Dias passados onde a carona aconteceu: Verde
        btn.classList.add('cal-celula--ride');
        estadoTexto = `${rotulo(dia)}: carona realizada.`;
        const icon = document.createElement('span');
        icon.className = 'cal-celula__status';
        icon.textContent = '✓';
        btn.append(icon);
      }

      btn.setAttribute('aria-label', estadoTexto);

      btn.onclick = () => {
        vibrar(12);
        detalheEl.hidden = false;
        detalheEl.textContent = estadoTexto;

        if (escDia && rodou && ehFuturoOuHoje) {
          btn.classList.add('stamp-pop');
          commit(async () => {
            await setMark(eu.id, dia, falta ? null : false);
            aviso(falta ? `Presença confirmada (${rotulo(dia)}).` : `Falta informada (${rotulo(dia)}).`);
          }, btn);
        }
      };

      grade.append(btn);
    }
  }

  $('mes-ant').onclick = () => {
    direcaoMes = 'ant';
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
    carregar();
  };
  $('mes-prox').onclick = () => {
    direcaoMes = 'prox';
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
    carregar();
  };

  async function iniciar() {
    if (!configured || !token) {
      $('carregando').hidden = true;
      $('invalido').hidden = false;
      return;
    }
    try {
      const p = await loadPassengerByToken(token);
      if (!p) {
        $('carregando').hidden = true;
        $('invalido').hidden = false;
        return;
      }
      eu = p;
      $('carregando').hidden = true;
      $('app').hidden = false;
      await carregar();
    } catch (e: any) {
      $('carregando').hidden = true;
      $('invalido').hidden = false;
    }
  }

  iniciar();
</script>
