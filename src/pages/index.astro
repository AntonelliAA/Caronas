---
import Layout from '../layouts/Layout.astro';
import Wheel from '../components/Wheel.astro';
---

<Layout title="Caronas">
  <header class="topbar">
    <span class="topbar__brand"><Wheel /> Caronas</span>
    <button id="theme-toggle" class="icon-btn" type="button" aria-label="Alternar tema claro e escuro">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 3a9 9 0 0 0 0 18Z" fill="currentColor" stroke="none"></path>
      </svg>
    </button>
    <button id="sair" class="icon-btn" type="button" aria-label="Sair" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
      </svg>
    </button>
  </header>

  <p id="erro" class="toast" role="alert" hidden></p>

  <main class="wrap">
    <!-- Without Supabase keys there is nothing to show. Say what to do instead. -->
    <section id="setup" class="card setup" hidden>
      <h1>Falta conectar o banco</h1>
      <p>Crie um projeto no Supabase, rode o <code>schema.sql</code> e preencha o <code>.env</code> com <code>PUBLIC_SUPABASE_URL</code> e <code>PUBLIC_SUPABASE_ANON_KEY</code>. O passo a passo está no README.</p>
    </section>

    <section id="login" hidden>
      <h1 class="titulo">Entrar</h1>
      <p class="muted sub">A tela do motorista. Quem pega carona usa o link pessoal.</p>
      <form id="login-form">
        <label class="field"><span>Email</span>
          <input type="email" id="email" autocomplete="username" required />
        </label>
        <label class="field"><span>Senha</span>
          <input type="password" id="senha" autocomplete="current-password" required />
        </label>
        <button class="btn btn--primary btn--block" type="submit">Entrar</button>
      </form>
    </section>

    <div id="esqueleto" hidden aria-hidden="true">
      <div class="sk sk--linha" style="width: 40%"></div>
      <div class="sk sk--valor"></div>
      <div class="sk sk--linha" style="width: 65%"></div>
      <div class="sk sk--card"></div>
      <div class="sk sk--card"></div>
      <div class="sk sk--card"></div>
    </div>

    <div id="app" hidden>
      <!-- Today leads the page. It is the only thing that changes daily and
           the reason the app gets opened; the month below it is the thing you
           browse. It also has to sit above the month nav, because it always
           shows today no matter which month those arrows are pointing at. -->
      <section id="hoje" class="hoje"></section>

      <nav class="mesnav">
        <button id="mes-ant" class="icon-btn" type="button" aria-label="Mês anterior">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <h2 id="mes-nome" class="mesnav__nome">—</h2>
        <button id="mes-prox" class="icon-btn" type="button" aria-label="Próximo mês">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </nav>

      <section id="total-secao" class="total">
        <span class="label">a receber no mês</span>
        <p id="total-valor" class="total__valor num">—</p>
        <p id="total-linha" class="muted total__linha"></p>
        <div class="total__acoes">
          <button id="copiar" class="btn btn--ghost" type="button">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
            Resumo do mês
          </button>
        </div>
      </section>

      <section>
        <span class="label">quem anda junto</span>
        <ul id="pessoas" class="pessoas"></ul>
        <button id="novo" class="btn btn--ghost btn--block" type="button">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"></path></svg>
          Adicionar pessoa
        </button>
      </section>

      <section id="folha-secao">
        <table class="folha">
          <caption class="folha__cap">folha do mês</caption>
          <thead><tr id="folha-head"></tr></thead>
          <tbody id="folha-body"></tbody>
        </table>
        <ul class="legenda">
          <li><span class="mark" style="--pc: var(--text-secondary)"></span> foi</li>
          <li><span class="mark mark--extra" style="--pc: var(--text-secondary)"></span> foi fora da escala</li>
          <li><span class="mark mark--absent">✕</span> faltou</li>
          <li><span class="mark mark--off"></span> não é dia dele</li>
        </ul>
        <p class="legenda-ajuda muted">Toque numa marca para trocar entre foi, faltou e fora da escala. Toque no dia para marcar que não teve carona pra ninguém.</p>
      </section>
    </div>
  </main>

  <dialog id="editor" aria-labelledby="editor-titulo">
    <form method="dialog" id="editor-form">
      <!-- Focus lands here on open, not on the first field. showModal() would
           otherwise put the caret in Nome, which wears the accent ring on an
           untouched form and throws the phone keyboard over the projection.
           A screen reader gets the sheet's title read out instead. -->
      <h2 id="editor-titulo" tabindex="-1">Pessoa</h2>

      <label class="field"><span>Nome</span>
        <input type="text" id="f-nome" required maxlength="40" autocomplete="off" enterkeyhint="done" />
      </label>

      <div class="field">
        <span id="f-dias-rot">Dias da semana</span>
        <div class="weekpick" id="f-dias" role="group" aria-labelledby="f-dias-rot"></div>
        <div class="weekpick-atalhos">
          <button type="button" class="chip-btn" id="f-dias-seg-sex">Seg a sex</button>
          <button type="button" class="chip-btn" id="f-dias-todos">Todos</button>
          <button type="button" class="chip-btn" id="f-dias-limpar">Limpar</button>
        </div>
        <span class="hint">A carona entra sozinha nesses dias. A pessoa só marca quando não for.</span>
      </div>

      <label class="field"><span>Valor por dia</span>
        <span class="money"><span aria-hidden="true">R$</span><input type="text" id="f-valor" required inputmode="decimal" placeholder="0,00" /></span>
      </label>

      <label class="field"><span>Primeiro dia</span>
        <input type="date" id="f-inicio" required />
        <span class="hint">Nada antes dessa data entra na conta.</span>
      </label>

      <!-- Only on an existing person: nobody stops riding before they start. -->
      <label class="field" id="f-fim-campo" hidden><span>Último dia</span>
        <input type="date" id="f-fim" />
        <span class="hint">Deixe vazio enquanto a pessoa ainda anda.</span>
      </label>

      <p id="f-resumo" class="editor__resumo"></p>

      <!-- Inside the dialog on purpose: a modal sits in the top layer, so the
           page-level error bar renders behind it and is never seen. -->
      <p id="f-erro" class="editor__erro" role="alert" hidden></p>

      <div class="editor__acoes">
        <button class="btn btn--ghost" value="cancel" type="submit" formnovalidate>Cancelar</button>
        <button class="btn btn--primary" value="ok" type="submit">Salvar</button>
      </div>
      <button class="apagar" id="f-apagar" type="button" hidden>Remover do grupo</button>
    </form>
  </dialog>

  <dialog id="pagamento" aria-labelledby="pagamento-titulo">
    <form method="dialog" id="pagamento-form">
      <h2 id="pagamento-titulo" tabindex="-1">Pagamentos</h2>

      <p id="pagamento-resumo" class="editor__resumo"></p>

      <div id="pagamento-lista"></div>

      <label class="field"><span>Novo pagamento</span>
        <span class="money"><span aria-hidden="true">R$</span><input type="text" id="f-pagamento-valor" inputmode="decimal" placeholder="0,00" enterkeyhint="done" /></span>
      </label>
      <button class="btn btn--ghost btn--block" id="pagamento-adicionar" type="button">Adicionar</button>

      <p id="pagamento-erro" class="editor__erro" role="alert" hidden></p>

      <div class="editor__acoes">
        <button class="btn btn--primary" value="ok" type="submit">Fechar</button>
      </div>
    </form>
  </dialog>
</Layout>

<style is:global>
  .titulo {
    font-size: 1.5rem;
    letter-spacing: -0.02em;
    margin: 1.5rem 0 0.25rem;
  }

  .sub {
    font-size: 0.9rem;
    margin-bottom: 1.5rem;
  }

  .setup {
    margin-top: 2rem;
  }

  .setup h1 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .setup p {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  .setup code {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }

  /* --- Month --- */
  .mesnav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 1rem 0 0.5rem;
  }

  .mesnav__nome {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-transform: lowercase;
    /* The one named region: it travels sideways while the rest cross-fades. */
    view-transition-name: mes;
  }

  /* --- Today ---
     The first block on the screen, because the daily question is who is in
     the car, not what the month adds up to. Full-width rows rather than the
     chips this used to be: the block earns the top of the screen by being the
     day's control surface, and it matches the passenger screen's day list. */
  .hoje {
    margin: 1.25rem 0 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  /* Red stays meaning "now" here even though the date itself is set in ink. */
  .hoje__quando {
    color: var(--accent);
  }

  .hoje__data {
    margin-bottom: 0.9rem;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-wrap: balance;
  }

  .hoje__lista {
    display: grid;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .hoje__lista li {
    border-bottom: 1px solid var(--border);
  }

  .hoje__lista li:last-child {
    border-bottom: none;
  }

  .hoje__pessoa {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    width: 100%;
    min-height: 56px;
    padding: 0.5rem 0.9rem;
    text-align: left;
    transition: background var(--transition-fast);
  }

  .hoje__pessoa:hover {
    background: var(--bg-card-hover);
  }

  .hoje__nome {
    flex: 1;
    min-width: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  /* The strike says it and the word says it, because the strike alone is a
     colour-and-decoration signal and this is the one state that costs money. */
  .hoje__pessoa[data-falta='1'] .hoje__nome {
    color: var(--text-secondary);
    text-decoration: line-through;
    text-decoration-color: var(--accent);
  }

  .hoje__estado {
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent);
  }

  .hoje__ajuda {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .hoje__vazio {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }

  /* --- Total --- */
  /* The money is the answer to a question asked twice a month, so it is set
     in ink. Red is left to mean "now" and "exception", which is the only way
     the today rule and the absence crosses keep their force. */
  .total__valor {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .total__linha {
    font-size: 0.85rem;
    margin-top: 0.5rem;
  }

  .total__acoes {
    margin: 1.1rem 0 2rem;
  }

  /* --- People / payment --- */
  .pessoas {
    display: grid;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }

  #novo {
    margin-bottom: 2rem;
  }

  .pessoa {
    padding: 0.8rem 0.85rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .pessoa__topo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pessoa__acoes {
    display: flex;
    gap: 0.25rem;
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  .acao {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    flex: 1;
    min-height: var(--tap);
    padding: 0 0.4rem;
    border-radius: var(--radius-sm);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .acao:hover {
    background: var(--bg-card-hover);
    color: var(--text-primary);
  }

  .pessoa[data-status='quitado'] .acao--pago {
    color: var(--success);
  }

  .acao svg {
    flex: none;
  }

  .pessoa__txt {
    flex: 1;
    min-width: 0;
  }

  .pessoa__nome {
    display: block;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .pessoa__det {
    display: block;
    font-size: 0.78rem;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .pessoa__valor {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
  }

  .pessoa[data-status='quitado'] .pessoa__valor {
    color: var(--text-faint);
    text-decoration: line-through;
  }

  /* --- The month's ledger: the main object on the screen --- */
  .folha {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }

  /* The caption is the table's own title, which is what a screen reader reads
     before deciding whether to walk the grid.
     It carries no shared class on purpose: .label sets display: block, and a
     display value on a table element throws away its native box. As a block the
     caption fell below the header row and wrapped to two lines. */
  .folha__cap {
    caption-side: top;
    text-align: left;
    padding-bottom: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .folha th,
  .folha td {
    padding: 0;
    text-align: center;
  }

  .folha__nome {
    display: block;
    margin-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 400;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .folha thead th {
    position: sticky;
    top: 56px;
    vertical-align: bottom;
    z-index: 10;
    padding: 0.35rem 0 0.5rem;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-hover);
  }

  .folha thead th:first-child {
    width: 4.6rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 400;
    color: var(--text-faint);
  }

  .folha tbody th {
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--text-secondary);
    font-variant-numeric: tabular-nums;
  }

  .folha tbody tr {
    border-bottom: 1px solid var(--border);
  }

  /* Today reads as a cursor sitting on the month, not as a highlighted band:
     a solid rule down the left and the date in red, with the fill barely
     there so the marks in the row stay the thing you look at. */
  .folha tbody tr.hoje-linha {
    border-bottom-color: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .folha tbody tr.hoje-linha th,
  .folha tbody tr.hoje-linha td {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .folha tbody tr.hoje-linha th {
    color: var(--accent);
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--accent);
  }

  @media (hover: hover) {
    .folha tbody tr:not(.semana-linha):hover th,
    .folha tbody tr:not(.semana-linha):hover td {
      background: var(--bg-card-hover);
    }
  }

  .dia-btn {
    display: block;
    width: 100%;
    min-height: var(--tap);
    padding: 0 0.15rem;
    text-align: left;
    font: inherit;
    color: inherit;
  }

  .cel {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: var(--tap);
  }

  .mark {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--pc);
  }

  .mark--absent {
    width: auto;
    height: auto;
    background: none;
    border-radius: 0;
    color: var(--accent);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1;
  }

  .mark--off {
    width: 10px;
    height: 1px;
    border-radius: 0;
    background: var(--border);
  }

  /* An extra ride is the same hue, hollow, so it reads as "counted, but not on
     the usual schedule" without inventing a second colour. */
  .mark--extra {
    background: none;
    border: 2px solid var(--pc);
  }

  /* Has to out-specify `.folha td`, which centres every cell. Without the
     element in the selector this row renders centred and the note drifts into
     the middle of the table. */
  .folha td.sem-carona {
    padding: 0.75rem 0;
    font-size: 0.72rem;
    color: var(--text-faint);
    text-align: left;
  }

  /* Weeks are the unit a carpool is actually planned in: "segunda a quarta"
     is a weekly sentence. Without this rule the month is 21 identical rows and
     nobody can find the week of the 17th. */
  .folha td.semana {
    padding: 1.1rem 0 0.35rem;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .folha tr.semana-linha {
    border-bottom: 1px solid var(--border-hover);
  }



  .legenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    margin-top: 0.85rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .legenda li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .legenda-ajuda {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.45;
  }

  /* --- First run --- */
  .vazio {
    padding: 1.25rem 1rem 1.4rem;
    border: 1px dashed var(--border-hover);
    border-radius: var(--radius-md);
    text-align: center;
  }

  .vazio__linhas {
    display: grid;
    gap: 0.4rem;
    justify-items: center;
    margin-bottom: 0.9rem;
  }

  .vazio__linhas span {
    display: block;
    height: 8px;
    border-radius: var(--radius-full);
    background: var(--border);
  }

  .vazio__linhas span:nth-child(1) { width: 45%; }
  .vazio__linhas span:nth-child(2) { width: 65%; }
  .vazio__linhas span:nth-child(3) { width: 30%; }

  .vazio__titulo {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .vazio__texto {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* --- Loading skeleton --- */
  #esqueleto {
    padding-top: 1.5rem;
  }

  .sk {
    border-radius: var(--radius-sm);
    background: var(--bg-card-hover);
    animation: pulso 1.4s ease-in-out infinite;
  }

  .sk--linha {
    height: 12px;
    margin-bottom: 0.9rem;
  }

  .sk--valor {
    height: 44px;
    width: 55%;
    margin-bottom: 0.9rem;
  }

  .sk--card {
    height: 92px;
    margin-bottom: 0.6rem;
    border-radius: var(--radius-md);
  }

  @keyframes pulso {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.45; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sk { animation: none; }
  }

  /* --- Editor dialog ---
     A drawer on a phone and a centred card on a desk. The form is the only
     place in the app where somebody types, and it is reached with one thumb
     while the car is parked, so on 390px it rises from the bottom edge where
     the thumb already is. */
  dialog {
    width: min(460px, calc(100vw - 2rem));
    /* A modal dialog is centred by the UA stylesheet's `margin: auto`, and the
       `* { margin: 0 }` reset at the top of global.css wipes it out, which
       pinned the sheet to the top-left corner. Saying it again here is the
       whole fix; the reset stays because everything else wants it. */
    margin: auto;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    opacity: 0;
    translate: 0 8px;
    /* allow-discrete keeps the element painted through the closing animation;
       without it display:none lands on frame one and nothing is seen. */
    transition: opacity 220ms ease, translate 260ms cubic-bezier(0.16, 1, 0.3, 1),
      overlay 260ms allow-discrete, display 260ms allow-discrete;
  }

  dialog[open] {
    opacity: 1;
    translate: 0 0;
  }

  @starting-style {
    dialog[open] {
      opacity: 0;
      translate: 0 8px;
    }
  }

  dialog::backdrop {
    background: rgba(0, 0, 0, 0);
    transition: background 220ms ease, overlay 220ms allow-discrete,
      display 220ms allow-discrete;
  }

  dialog[open]::backdrop {
    background: rgba(0, 0, 0, 0.45);
  }

  @starting-style {
    dialog[open]::backdrop {
      background: rgba(0, 0, 0, 0);
    }
  }

  @media (max-width: 719px) {
    dialog {
      width: 100%;
      max-width: none;
      max-height: 92dvh;
      overflow-y: auto;
      /* auto on three sides, 0 at the bottom: the sheet sits on the edge. */
      margin: auto auto 0;
      border-bottom: none;
      border-radius: 18px 18px 0 0;
      padding-bottom: calc(1.25rem + env(safe-area-inset-bottom));
      translate: 0 100%;
    }

    @starting-style {
      dialog[open] {
        translate: 0 100%;
      }
    }

    /* The grabber says "this came from the bottom and goes back there". It is
       drawn, not dragged: dragging a sheet needs a pointer handler and a
       velocity threshold to feel right, and the backdrop already closes it. */
    dialog::before {
      content: '';
      display: block;
      width: 36px;
      height: 4px;
      margin: -0.4rem auto 0.9rem;
      border-radius: var(--radius-full);
      background: var(--border-hover);
    }
  }

  dialog h2 {
    margin-bottom: 1.25rem;
    font-size: 1.15rem;
    letter-spacing: -0.02em;
  }

  /* What the schedule above adds up to, in the only unit that matters here.
     It is the reason the weekday row exists, so it sits directly under it. */
  .editor__resumo {
    margin-top: 1.25rem;
    padding: 0.8rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-variant-numeric: tabular-nums;
  }

  .editor__resumo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .editor__resumo-badge {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .editor__resumo-valor {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .editor__resumo-detalhe {
    font-size: 0.75rem;
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .editor__erro {
    margin-top: 0.85rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
  }

  .editor__acoes {
    display: flex;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .editor__acoes .btn {
    flex: 1;
  }

  .apagar {
    display: block;
    width: 100%;
    min-height: var(--tap);
    margin-top: 0.75rem;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    font-size: 0.8rem;
    color: var(--accent);
  }

  /* Second press confirms. A native confirm() over a modal shows the origin
     hostname and drops the person out of the app to answer a browser
     question; the answer belongs in the sheet that asked. */
  .apagar[data-confirmar='1'] {
    background: var(--accent-soft);
    font-weight: 600;
  }

  .pagamentos {
    display: grid;
    gap: 0.4rem;
    margin: 1rem 0;
  }

  .pagamentos li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.2rem 0.5rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }

  .pagamentos time {
    display: block;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .pagamentos button {
    min-height: var(--tap);
    min-width: var(--tap);
    color: var(--text-secondary);
  }

  .pagamentos button:hover {
    color: var(--accent);
  }

  .pagamentos-vazio {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 1rem 0;
  }
</style>

<script>
  import {
    brl,
    dayState,
    isScheduled,
    ledgerDays,
    monthDays,
    monthKey,
    monthLabel,
    money,
    nextMark,
    weekStart,
    paidSoFar,
    parseBrl,
    parseYmd,
    report,
    weekdayList,
    WEEKDAY_SHORT,
    ymd,
  } from '../lib/rides';
  import { feriados } from '../lib/feriados';
  import {
    addPayment,
    configured,
    db,
    loadMonth,
    loadPassengers,
    removePassenger,
    removePayment,
    savePassenger,
    setMark,
    setOverride,
    type PassengerRow,
  } from '../lib/db';
  import confetti from 'canvas-confetti';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const hoje = ymd(new Date());
  let cursor = new Date();
  let pessoas: PassengerRow[] = [];
  let mes: Awaited<ReturnType<typeof loadMonth>>;

  // ponytail: three validated hues; a fourth passenger reuses the first.
  // Every colored mark has a name beside it or above its column, so reuse
  // never leaves anyone guessing. If the group grows past three, validate a
  // fourth hue before adding --p3.
  const cor = (i: number) => `var(--p${i % 3})`;
  const esc = (s: string) =>
    s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  const marksOf = (id: string) => mes.marks.get(id) ?? new Map<string, boolean>();

  /** What a person's payments add up to against what report() says they owe. */
  const pagamentoStatus = (p: PassengerRow, r: ReturnType<typeof report>) => {
    const pagos = mes.payments.get(p.id) ?? [];
    const feito = paidSoFar(pagos);
    return { pagos, feito, quitado: r.total > 0 && feito >= r.total };
  };

  const relatorioAtual = (p: PassengerRow) => {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    return report(p, monthDays(ano, m0), marksOf(p.id), mes.overrides, feriados(ano), hoje);
  };

  const semMovimento = matchMedia('(prefers-reduced-motion: reduce)');

  function vibrar(ms = 15) {
    try {
      if ('vibrate' in navigator) navigator.vibrate(ms);
    } catch {}
  }

  function dispararConfetes() {
    if (semMovimento.matches) return;
    try {
      confetti({
        particleCount: 45,
        spread: 60,
        origin: { y: 0.75 },
        colors: ['#2A78D6', '#1BAF7A', '#EDA100', '#C1121F'],
        disableForReducedMotion: true,
      });
    } catch {}
  }

  function aviso(msg: string, ok = false) {
    const el = $('erro');
    el.textContent = msg;
    el.dataset.ok = ok ? '1' : '0';
    el.hidden = false;
    setTimeout(() => (el.hidden = true), ok ? 2500 : 6000);
  }

  const erro = (msg: string) => aviso(msg);

  /**
   * Every write goes through here, so a failure is never silent. `alvo` is the
   * control that was tapped: it steps back for as long as the request is in
   * flight, which on a phone in a parking garage is the difference between a
   * tap that landed and a tap that did nothing.
   */
  async function commit(fn: () => Promise<void>, alvo?: HTMLElement) {
    alvo?.classList.add('pendente');
    try {
      await fn();
      await carregar();
    } catch (e: any) {
      erro(e?.message ?? 'Não deu para salvar. Tente de novo.');
      alvo?.classList.remove('pendente');
    }
  }

  // ------------------------------------------------------------------ data ---

  async function carregar() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    // The fetched window always includes today, otherwise the "today" card goes
    // blind while the driver is looking at another month.
    const de = dias[0] < hoje ? dias[0] : hoje;
    const ate = dias[dias.length - 1] > hoje ? dias[dias.length - 1] : hoje;
    if (primeiraCarga) mostrar('carregando');
    try {
      pessoas = await loadPassengers();
      mes = await loadMonth(de, ate, monthKey(ano, m0));
      pintar();
      mostrar('app');
      primeiraCarga = false;
    } catch (e: any) {
      mostrar('app');
      primeiraCarga = false;
      erro(e?.message ?? 'Não deu para carregar o mês.');
    }
  }

  // ---------------------------------------------------------------- render ---

  /** Set by the month arrows, and only by them. */
  let direcaoMes: 'ant' | 'prox' | null = null;

  /**
   * The fetch has already landed by the time this runs, so the snapshot the
   * view transition holds is never a frozen screen waiting on the network.
   * A month change slides; a single mark toggling repaints in place, because
   * cross-fading the whole page on every tap of a dot reads as lag.
   */
  function pintar() {
    const dir = direcaoMes;
    direcaoMes = null;
    if (!dir || semMovimento.matches || !document.startViewTransition) return render();
    document.documentElement.dataset.mes = dir;
    document.startViewTransition(() => render());
  }

  function render() {
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    const fer = feriados(ano);

    $('mes-nome').textContent = monthLabel(ano, m0);

    const relatos = pessoas.map((p) =>
      report(p, dias, marksOf(p.id), mes.overrides, fer, hoje),
    );

    // With nobody registered, a zeroed total and an empty ledger are noise on
    // the one screen that should say "add someone".
    const vazio = pessoas.length === 0;
    $('hoje').hidden = vazio;
    $('total-secao').hidden = vazio;
    $('folha-secao').hidden = vazio;

    renderHoje();
    renderTotal(relatos);
    renderPessoas(relatos);
    renderFolha(dias, fer);
  }

  function renderHoje() {
    const el = $('hoje');
    const d = parseYmd(hoje);
    // Holidays for today's year, not for the month on screen.
    const fer = feriados(d.getFullYear());
    el.innerHTML = '';

    const eyebrow = document.createElement('span');
    eyebrow.className = 'label hoje__quando';
    eyebrow.textContent = 'hoje';
    el.append(eyebrow);

    const titulo = document.createElement('h1');
    titulo.className = 'hoje__data';
    // "segunda-feira, 17 de agosto" is not how anybody says it out loud.
    titulo.textContent = new Intl.DateTimeFormat('pt-BR', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
    })
      .format(d)
      .replace('-feira', '');
    el.append(titulo);

    const forcado = mes.overrides.get(hoje);
    const rodou = forcado !== undefined ? forcado : !fer.has(hoje);
    const escalados = pessoas.filter(
      (p) =>
        p.weekdays.includes(d.getDay()) &&
        hoje >= p.start_date &&
        (!p.end_date || hoje <= p.end_date),
    );

    if (!rodou) {
      const t = document.createElement('p');
      t.className = 'hoje__vazio';
      t.textContent = fer.get(hoje) ? `${fer.get(hoje)} — sem carona hoje.` : 'Sem carona hoje.';
      el.append(t);
      return;
    }
    if (escalados.length === 0) {
      const t = document.createElement('p');
      t.className = 'hoje__vazio';
      t.textContent = 'Ninguém escalado para hoje.';
      el.append(t);
      return;
    }

    const lista = document.createElement('ul');
    lista.className = 'hoje__lista';

    for (const p of escalados) {
      const i = pessoas.indexOf(p);
      const faltou = marksOf(p.id).get(hoje) === false;
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'hoje__pessoa';
      b.dataset.falta = faltou ? '1' : '0';
      b.setAttribute('aria-pressed', String(faltou));
      b.innerHTML =
        `<span class="dot" style="--pc:${cor(i)}"></span>` +
        `<span class="hoje__nome">${esc(p.name)}</span>` +
        (faltou ? '<span class="hoje__estado">faltou</span>' : '');
      b.setAttribute(
        'aria-label',
        faltou ? `${p.name} faltou hoje. Desfazer.` : `Marcar falta de ${p.name} hoje`,
      );
      b.onclick = () => {
        vibrar(15);
        ultimaMarca = `${p.id}:${hoje}`;
        commit(() => setMark(p.id, hoje, faltou ? null : false), b);
      };
      const li = document.createElement('li');
      li.append(b);
      lista.append(li);
    }
    el.append(lista);

    const ajuda = document.createElement('p');
    ajuda.className = 'hoje__ajuda';
    ajuda.textContent = 'Toque num nome para marcar falta.';
    el.append(ajuda);
  }

  let totalAnterior = '';

  function renderTotal(relatos: ReturnType<typeof report>[]) {
    const feito = relatos.reduce((s, r) => s + r.total, 0);
    const previsto = relatos.reduce((s, r) => s + r.plannedTotal, 0);
    const caronas = relatos.reduce((s, r) => s + r.done, 0);
    const faltas = relatos.reduce((s, r) => s + r.faltas, 0);

    // A mark two screens down changes this number, and the connection between
    // the two is invisible if it just swaps. It is the same figure moving, so
    // it lifts rather than fades: a new value would arrive, this one changed.
    const valor = brl(feito);
    const el = $('total-valor');
    if (totalAnterior && totalAnterior !== valor && !semMovimento.matches) {
      el.animate(
        [{ opacity: 0.3, translate: '0 -6px' }, { opacity: 1, translate: '0 0' }],
        { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' },
      );
    }
    totalAnterior = valor;
    el.textContent = valor;
    const partes = [`${caronas} ${caronas === 1 ? 'carona' : 'caronas'}`];
    if (faltas) partes.push(`${faltas} ${faltas === 1 ? 'falta' : 'faltas'}`);
    if (previsto > feito) partes.push(`${brl(previsto)} se o mês fechar como está`);
    $('total-linha').textContent = partes.join(' · ');
  }

  function renderPessoas(relatos: ReturnType<typeof report>[]) {
    const el = $('pessoas');
    el.innerHTML = '';

    if (pessoas.length === 0) {
      // First run. A shape on screen reads as "nothing here yet" far faster
      // than a sentence does, and the button below it is the only next step.
      el.innerHTML = `
        <li class="vazio">
          <div class="vazio__linhas" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <p class="vazio__titulo">Ninguém anda junto ainda</p>
          <p class="vazio__texto">Cadastre a primeira pessoa com os dias em que ela vai e o valor por dia. A partir daí a carona entra sozinha.</p>
        </li>`;
      return;
    }

    pessoas.forEach((p, i) => {
      const r = relatos[i];
      const { feito, quitado } = pagamentoStatus(p, r);
      const parcial = feito > 0 && !quitado;
      const li = document.createElement('li');
      li.className = 'pessoa';
      li.dataset.status = quitado ? 'quitado' : parcial ? 'parcial' : 'pendente';

      const detalhe = [
        weekdayList(p.weekdays),
        `${r.done} × ${brl(p.fare)}`,
        r.faltas ? `${r.faltas} falta${r.faltas > 1 ? 's' : ''}` : '',
        p.end_date ? 'saiu' : '',
      ]
        .filter(Boolean)
        .join(' · ');

      li.innerHTML = `
        <div class="pessoa__topo">
          <span class="dot" style="--pc:${cor(i)}"></span>
          <span class="pessoa__txt">
            <span class="pessoa__nome">${esc(p.name)}</span>
            <span class="pessoa__det">${esc(detalhe)}</span>
          </span>
          <span class="pessoa__valor">${brl(r.total)}</span>
        </div>`;

      const acoes = document.createElement('div');
      acoes.className = 'pessoa__acoes';

      const bPago = document.createElement('button');
      bPago.type = 'button';
      bPago.className = 'acao acao--pago';
      bPago.setAttribute('aria-label', `Pagamentos de ${p.name}`);
      bPago.innerHTML = quitado
        ? '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>Pago'
        : parcial
          ? `${brl(feito)} de ${brl(r.total)}`
          : 'Marcar pago';
      bPago.onclick = () => {
        vibrar(15);
        abrirPagamento(p);
      };

      const bLink = document.createElement('button');
      bLink.type = 'button';
      bLink.className = 'acao';
      bLink.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8M16 6l-4-4-4 4M12 2v14"/></svg>Enviar link';
      bLink.setAttribute('aria-label', `Enviar o link de ${p.name}`);
      bLink.onclick = () => compartilhar(p);

      const bEdit = document.createElement('button');
      bEdit.type = 'button';
      bEdit.className = 'acao';
      bEdit.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Editar';
      bEdit.setAttribute('aria-label', `Editar ${p.name}`);
      bEdit.onclick = () => abrirEditor(p);

      acoes.append(bPago, bLink, bEdit);
      li.append(acoes);
      el.append(li);
    });
  }

  /** Inside their period, so a one-off ride can be added even off-schedule. */
  const podeEntrar = (p: PassengerRow, dia: string) =>
    dia >= p.start_date && (!p.end_date || dia <= p.end_date);

  /** `passengerId:day` of the cell tapped last, so only its mark animates in. */
  let ultimaMarca: string | null = null;

  function renderFolha(dias: string[], fer: Map<string, string>) {
    const head = $('folha-head');
    const body = $('folha-body');
    head.innerHTML = '<th scope="col">dia</th>';
    body.innerHTML = '';

    pessoas.forEach((p, i) => {
      const th = document.createElement('th');
      th.scope = 'col';
      // Full first name in the column header: it fits, and nobody has to decode initials.
      th.innerHTML = `<span class="dot" style="--pc:${cor(i)}"></span><span class="folha__nome">${esc(p.name.split(' ')[0])}</span>`;
      head.append(th);
    });

    const linhas = ledgerDays(pessoas, dias, mes.marks);
    let semanaAtual = '';
    for (const dia of linhas) {
      const d = parseYmd(dia);

      const semana = weekStart(dia);
      if (semana !== semanaAtual) {
        semanaAtual = semana;
        const trS = document.createElement('tr');
        trS.className = 'semana-linha';
        const tdS = document.createElement('td');
        tdS.className = 'semana';
        tdS.colSpan = pessoas.length + 1;
        tdS.textContent = `semana de ${parseYmd(semana).getDate()}`;
        trS.append(tdS);
        body.append(trS);
      }

      const tr = document.createElement('tr');
      if (dia === hoje) tr.className = 'hoje-linha';

      const forcado = mes.overrides.get(dia);
      const rodou = forcado !== undefined ? forcado : !fer.has(dia);

      const th = document.createElement('th');
      th.scope = 'row';
      const diaBtn = document.createElement('button');
      diaBtn.type = 'button';
      diaBtn.className = 'dia-btn';
      diaBtn.textContent = `${WEEKDAY_SHORT[d.getDay()]} ${String(d.getDate()).padStart(2, '0')}`;
      const falado = new Intl.DateTimeFormat('pt-BR', {
        weekday: 'long',
        day: 'numeric',
        month: 'long',
      }).format(d);
      diaBtn.setAttribute(
        'aria-label',
        rodou
          ? `${falado}: marcar que não teve carona`
          : `${falado}: sem carona. Marcar que teve.`,
      );
      // One tap cycles the day: normal → no ride → normal. On a holiday the
      // cycle inverts, because there the default is already "no ride".
      diaBtn.onclick = () => {
        vibrar(15);
        commit(
          () => setOverride(dia, forcado === undefined ? !rodou : null, fer.get(dia)),
          diaBtn,
        );
      };
      th.append(diaBtn);
      tr.append(th);

      if (!rodou) {
        const td = document.createElement('td');
        td.colSpan = Math.max(pessoas.length, 1);
        td.className = 'sem-carona';
        td.textContent = fer.get(dia) ?? mes.overrideNotes.get(dia) ?? 'sem carona';
        tr.append(td);
        body.append(tr);
        continue;
      }

      pessoas.forEach((p, i) => {
        const td = document.createElement('td');
        const estado = dayState(p, dia, marksOf(p.id).get(dia), true);
        // Outside their start/end range there is nothing to toggle, so the cell
        // stays inert. Every other state cycles on tap, including a day that is
        // not theirs: that is how a one-off ride gets added.
        const inerte = estado === 'off' && !podeEntrar(p, dia);

        if (inerte) {
          td.innerHTML = '<span class="cel"><span class="mark mark--off"></span></span>';
          tr.append(td);
          return;
        }

        const rotulos: Record<string, string> = {
          ride: 'foi. Tocar marca falta.',
          extra: 'foi fora da escala. Tocar desfaz.',
          absent: 'faltou. Tocar desfaz.',
          off: 'não é dia dele. Tocar registra que foi.',
        };
        const marcas: Record<string, string> = {
          ride: `<span class="mark" style="--pc:${cor(i)}"></span>`,
          extra: `<span class="mark mark--extra" style="--pc:${cor(i)}"></span>`,
          absent: '<span class="mark mark--absent">✕</span>',
          off: '<span class="mark mark--off"></span>',
        };

        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'cel';
        b.dataset.estado = estado;
        b.setAttribute('aria-label', `${p.name}, ${falado}: ${rotulos[estado]}`);
        b.innerHTML = marcas[estado];
        // The cell that was just tapped is rebuilt from scratch by the reload,
        // so the new mark lands instead of appearing. Only that one cell.
        if (ultimaMarca === `${p.id}:${dia}`) b.firstElementChild?.classList.add('marca-nova');
        b.onclick = () => {
          vibrar(15);
          ultimaMarca = `${p.id}:${dia}`;
          commit(() => setMark(p.id, dia, nextMark(estado)), b);
        };
        td.append(b);
        tr.append(td);
      });
      body.append(tr);
    }
    ultimaMarca = null;
  }

  // ----------------------------------------------------------------- share ---

  function linkDe(p: PassengerRow) {
    // Same trailing-slash trap as the layout: BASE_URL has no slash of its own.
    const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
    return `${location.origin}${base}p/?t=${p.token}`;
  }

  async function compartilhar(p: PassengerRow) {
    const url = linkDe(p);
    const text = `${p.name}, esse é o seu link das caronas. Salve na tela de início: quando não for num dia, marque aqui que eu já desconto.\n${url}`;
    try {
      if (navigator.share) await navigator.share({ title: 'Caronas', text });
      else {
        await navigator.clipboard.writeText(text);
        aviso('Link copiado.', true);
      }
    } catch {
      /* share sheet dismissed */
    }
  }

  async function copiarResumo() {
    vibrar(15);
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    const dias = monthDays(ano, m0);
    const fer = feriados(ano);

    const linhas = pessoas.map((p) => {
      const r = report(p, dias, marksOf(p.id), mes.overrides, fer, hoje);
      const falta = r.faltas ? ` (${r.faltas} falta${r.faltas > 1 ? 's' : ''})` : '';
      return `${p.name}: ${r.done} × ${brl(p.fare)} = ${brl(r.total)}${falta}`;
    });
    const total = pessoas.reduce(
      (s, p) => s + report(p, dias, marksOf(p.id), mes.overrides, fer, hoje).total,
      0,
    );
    const texto = `Caronas de ${monthLabel(ano, m0)}\n\n${linhas.join('\n')}\n\nTotal: ${brl(total)}`;

    const btn = $('copiar');
    // Captured once, not per call: a second tap inside the two seconds would
    // read "Copiado!" as the markup to restore and the button would wear that
    // label for the rest of the session.
    if (copiarHtml === null) copiarHtml = btn.innerHTML;
    try {
      let rotulo: string;
      if (navigator.share) {
        await navigator.share({ text: texto });
        // Nothing reached the clipboard on this path, and on a phone it is the
        // only path there is.
        rotulo = 'Enviado!';
      } else {
        await navigator.clipboard.writeText(texto);
        aviso('Resumo copiado.', true);
        rotulo = 'Copiado!';
      }
      clearTimeout(copiarTimer);
      btn.classList.add('btn--copiado');
      btn.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg> ' +
        rotulo;
      copiarTimer = setTimeout(() => {
        btn.classList.remove('btn--copiado');
        btn.innerHTML = copiarHtml as string;
      }, 2000);
    } catch {
      /* share sheet dismissed */
    }
  }

  let copiarHtml: string | null = null;
  let copiarTimer: ReturnType<typeof setTimeout>;

  // ---------------------------------------------------------------- editor ---

  let editando: PassengerRow | null = null;
  let diasSel = new Set<number>();
  const WEEK_DISPLAY_ORDER = [1, 2, 3, 4, 5, 6, 0];

  function montarWeekpick() {
    const box = $('f-dias');
    box.innerHTML = '';
    WEEK_DISPLAY_ORDER.forEach((d) => {
      const nome = WEEKDAY_SHORT[d];
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = nome;
      b.dataset.fds = d === 0 || d === 6 ? '1' : '0';
      b.setAttribute('aria-pressed', String(diasSel.has(d)));
      b.onclick = () => {
        vibrar(12);
        diasSel.has(d) ? diasSel.delete(d) : diasSel.add(d);
        b.setAttribute('aria-pressed', String(diasSel.has(d)));
        b.classList.add('stamp-pop');
        setTimeout(() => b.classList.remove('stamp-pop'), 180);
        resumoEditor();
      };
      box.append(b);
    });
  }

  /**
   * What the days above are worth. The schedule is the only thing anybody
   * fills in here and the bill is what it produces, so the form shows the
   * bill while it is being typed instead of at the end of the month.
   */
  function resumoEditor() {
    // Any edit clears the last complaint: the form re-answers it by changing.
    erroEditor(null);
    const el = $('f-resumo');
    // Nothing to project, and saying "pick some days" here would repeat the
    // alert that Salvar raises in the same corner of the sheet.
    el.hidden = diasSel.size === 0;
    if (el.hidden) return;
    const ano = cursor.getFullYear();
    const m0 = cursor.getMonth();
    // Unparseable while somebody is still typing is not an error yet, it just
    // has no money in it. Salvar is where it has to be a number.
    const fare = parseBrl(($('f-valor') as HTMLInputElement).value) ?? 0;
    const previa = {
      id: 'previa',
      name: '',
      weekdays: [...diasSel],
      fare,
      start_date: ($('f-inicio') as HTMLInputElement).value || hoje,
      end_date: ($('f-fim') as HTMLInputElement).value || null,
    };
    // `mes` is undefined when the month failed to load: carregar() still shows
    // the app so the roster stays reachable. Without this guard the projection
    // throws inside abrirEditor and the sheet never opens at all — the one
    // screen you need when the month is broken is the one that edits it.
    const r = report(
      previa,
      monthDays(ano, m0),
      new Map(),
      mes?.overrides ?? new Map(),
      feriados(ano),
      hoje,
    );
    // Holidays and the days the driver called off are already out of this
    // count, which is the whole reason it is worth showing.
    el.innerHTML = `
      <div class="editor__resumo-header">
        <span class="editor__resumo-badge">${r.planned} ${r.planned === 1 ? 'carona prevista' : 'caronas previstas'}</span>
        ${previa.fare > 0 ? `<span class="editor__resumo-valor">${brl(r.plannedTotal)}</span>` : ''}
      </div>
      <p class="editor__resumo-detalhe">em ${esc(monthLabel(ano, m0))} · feriados e folgas já descontados</p>`;
  }

  function erroEditor(msg: string | null) {
    const el = $('f-erro');
    el.textContent = msg ?? '';
    el.hidden = !msg;
  }

  function abrirEditor(p: PassengerRow | null) {
    editando = p;
    diasSel = new Set(p?.weekdays ?? [1, 2, 3, 4, 5]);
    $('editor-titulo').textContent = p ? `Editar ${p.name.split(' ')[0]}` : 'Nova pessoa';
    ($('f-nome') as HTMLInputElement).value = p?.name ?? '';
    ($('f-valor') as HTMLInputElement).value = p?.fare ? p.fare.toFixed(2).replace('.', ',') : '';
    ($('f-inicio') as HTMLInputElement).value = p?.start_date ?? hoje;
    ($('f-fim') as HTMLInputElement).value = p?.end_date ?? '';
    // Nobody stops riding before they start, so the field only exists on
    // somebody who already does.
    $('f-fim-campo').hidden = !p;
    $('f-apagar').hidden = !p;
    delete $('f-apagar').dataset.confirmar;
    $('f-apagar').textContent = 'Remover do grupo';
    erroEditor(null);
    montarWeekpick();
    resumoEditor();
    ($('editor') as HTMLDialogElement).showModal();
    $('editor-titulo').focus();
  }

  for (const id of ['f-valor', 'f-inicio', 'f-fim']) {
    $(id).addEventListener('input', resumoEditor);
  }

  $('f-dias-seg-sex').onclick = () => {
    vibrar(15);
    diasSel = new Set([1, 2, 3, 4, 5]);
    montarWeekpick();
    resumoEditor();
  };
  $('f-dias-todos').onclick = () => {
    vibrar(15);
    diasSel = new Set([1, 2, 3, 4, 5, 6, 0]);
    montarWeekpick();
    resumoEditor();
  };
  $('f-dias-limpar').onclick = () => {
    vibrar(15);
    diasSel.clear();
    montarWeekpick();
    resumoEditor();
  };

  // Clicking the backdrop closes the sheet. The dialog fills its own box, so a
  // click landing on the element itself landed outside the form.
  $('editor').addEventListener('click', (ev) => {
    if (ev.target === $('editor')) ($('editor') as HTMLDialogElement).close();
  });

  $('editor-form').addEventListener('submit', (ev) => {
    const acao = (ev as SubmitEvent).submitter as HTMLButtonElement | null;
    if (acao?.value !== 'ok') return;
    if (diasSel.size === 0) {
      ev.preventDefault();
      erroEditor('Escolha pelo menos um dia da semana.');
      $('f-dias').querySelector('button')?.focus();
      return;
    }
    // The field is type="text" so both separators can be typed, which also
    // means the browser no longer rejects "quinze". A fare that fell through
    // as 0 would price every ride this person takes at nothing.
    const fare = parseBrl(($('f-valor') as HTMLInputElement).value);
    if (fare === null) {
      ev.preventDefault();
      erroEditor('Informe o valor por dia. Por exemplo: 18,50.');
      $('f-valor').focus();
      return;
    }
    const dados = {
      id: editando?.id,
      name: ($('f-nome') as HTMLInputElement).value.trim(),
      weekdays: [...diasSel].sort(),
      fare,
      start_date: ($('f-inicio') as HTMLInputElement).value,
      end_date: ($('f-fim') as HTMLInputElement).value || null,
    };
    commit(() => savePassenger(dados as any));
  });

  // Two presses, both inside the sheet. Removing somebody takes their absences
  // and their payments with them, so it asks; it asks here rather than through
  // confirm(), which on a phone is a browser dialog naming the hostname.
  $('f-apagar').addEventListener('click', () => {
    const b = $('f-apagar');
    if (!editando) return;
    if (b.dataset.confirmar !== '1') {
      b.dataset.confirmar = '1';
      b.textContent = 'Remover mesmo? As faltas e os pagamentos vão junto.';
      return;
    }
    const id = editando.id;
    ($('editor') as HTMLDialogElement).close();
    commit(() => removePassenger(id));
  });

  // -------------------------------------------------------------- pagamento ---

  let pagando: PassengerRow | null = null;

  const formatoPagamento = new Intl.DateTimeFormat('pt-BR', {
    day: '2-digit',
    month: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });

  function erroPagamento(msg: string | null) {
    const el = $('pagamento-erro');
    el.textContent = msg ?? '';
    el.hidden = !msg;
  }

  /** Re-reads the current month's state for whoever the dialog is open on. */
  function renderPagamento() {
    if (!pagando) return;
    const r = relatorioAtual(pagando);
    const { pagos, feito, quitado } = pagamentoStatus(pagando, r);

    $('pagamento-titulo').textContent = `Pagamentos de ${pagando.name.split(' ')[0]}`;

    const resta = money(Math.max(0, r.total - feito));
    $('pagamento-resumo').innerHTML = `
      <div class="editor__resumo-header">
        <span class="editor__resumo-badge">${quitado ? 'Quitado' : feito > 0 ? 'Pago em parte' : 'Nada pago ainda'}</span>
        <span class="editor__resumo-valor">${brl(feito)} de ${brl(r.total)}</span>
      </div>
      <p class="editor__resumo-detalhe">${quitado ? 'Tudo certo por aqui.' : `Faltam ${brl(resta)}.`}</p>`;

    const lista = $('pagamento-lista');
    lista.replaceChildren();
    if (pagos.length === 0) {
      const vazio = document.createElement('p');
      vazio.className = 'pagamentos-vazio';
      vazio.textContent = 'Nenhum pagamento registrado ainda.';
      lista.append(vazio);
      return;
    }
    const ul = document.createElement('ul');
    ul.className = 'pagamentos';
    for (const entry of [...pagos].sort((a, b) => a.paid_at.localeCompare(b.paid_at))) {
      const li = document.createElement('li');
      li.innerHTML = `<span>${brl(entry.amount)}<time>${formatoPagamento.format(new Date(entry.paid_at))}</time></span>`;
      const bDel = document.createElement('button');
      bDel.type = 'button';
      bDel.setAttribute('aria-label', `Remover pagamento de ${brl(entry.amount)}`);
      bDel.innerHTML =
        '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12"/></svg>';
      bDel.onclick = () => {
        vibrar(15);
        commit(() => removePayment(entry.id), bDel).then(renderPagamento);
      };
      li.append(bDel);
      ul.append(li);
    }
    lista.append(ul);
  }

  function abrirPagamento(p: PassengerRow) {
    pagando = p;
    erroPagamento(null);
    ($('f-pagamento-valor') as HTMLInputElement).value = '';
    renderPagamento();
    ($('pagamento') as HTMLDialogElement).showModal();
    $('pagamento-titulo').focus();
  }

  $('pagamento-adicionar').onclick = () => {
    if (!pagando) return;
    const input = $('f-pagamento-valor') as HTMLInputElement;
    const valor = parseBrl(input.value);
    if (valor === null || valor <= 0) {
      erroPagamento('Informe um valor maior que zero. Por exemplo: 50,00.');
      input.focus();
      return;
    }
    erroPagamento(null);
    vibrar(20);
    const p = pagando;
    const chave = monthKey(cursor.getFullYear(), cursor.getMonth());
    const jaQuitado = pagamentoStatus(p, relatorioAtual(p)).quitado;
    commit(() => addPayment(p.id, chave, valor), $('pagamento-adicionar')).then(() => {
      input.value = '';
      if (pagando?.id !== p.id) return;
      renderPagamento();
      if (!jaQuitado && pagamentoStatus(p, relatorioAtual(p)).quitado) dispararConfetes();
    });
  };

  // Clicking the backdrop closes the sheet, same as the editor.
  $('pagamento').addEventListener('click', (ev) => {
    if (ev.target === $('pagamento')) ($('pagamento') as HTMLDialogElement).close();
  });

  $('pagamento').addEventListener('close', () => {
    pagando = null;
  });

  // --------------------------------------------------------------- screens ---

  let primeiraCarga = true;

  function mostrar(tela: 'setup' | 'login' | 'app' | 'carregando') {
    $('setup').hidden = tela !== 'setup';
    $('login').hidden = tela !== 'login';
    $('esqueleto').hidden = tela !== 'carregando';
    $('app').hidden = tela !== 'app';
    $('sair').hidden = tela === 'setup' || tela === 'login';
  }

  $('mes-ant').onclick = () => {
    direcaoMes = 'ant';
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1);
    carregar();
  };
  $('mes-prox').onclick = () => {
    direcaoMes = 'prox';
    cursor = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1);
    carregar();
  };
  $('copiar').onclick = copiarResumo;
  $('novo').onclick = () => abrirEditor(null);
  $('sair').onclick = async () => {
    await db.auth.signOut();
    mostrar('login');
  };

  $('login-form').addEventListener('submit', async (ev) => {
    ev.preventDefault();
    const { error } = await db.auth.signInWithPassword({
      email: ($('email') as HTMLInputElement).value,
      password: ($('senha') as HTMLInputElement).value,
    });
    if (error) erro('Email ou senha não conferem.');
  });

  if (!configured) {
    mostrar('setup');
  } else {
    db.auth.onAuthStateChange((_e, session) => {
      if (session) {
        carregar();
      } else {
        mostrar('login');
      }
    });
  }
</script>
